#!/usr/bin/env bash
# info: (re)generate SSH deploy key for web domain git deploy
# options: USER DOMAIN
# labels: panel web
#
# example: v-plugin-git-key-generate alice example.com

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-key-generate <user> <domain>"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

generate_deploy_key "$user" "$domain"
update_known_hosts "$user" "$domain"

cfg="$(config_path "$user" "$domain")"
set_config_value "$cfg" "DEPLOY_KEY_PATH" "$(deploy_key_path "$user" "$domain")"

pub="$(deploy_key_pub_path "$user" "$domain")"
echo "OK"
echo "DEPLOY_KEY_PUB: ${pub}"
echo "-----"
cat "$pub"
echo "-----"
echo "Re-add this public key as Deploy Key in your Git host (old key is invalidated)."
