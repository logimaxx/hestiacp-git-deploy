#!/usr/bin/env bash
# info: write build-only secrets.env for git deploy
# options: USER DOMAIN
# labels: panel web
#
# Reads KEY=VALUE pairs from stdin (one per line). Overwrites secrets.env.
# Empty stdin clears to a stub file.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-secrets-write <user> <domain> [file|-]"
	echo "  Reads KEY=VALUE lines from file, '-' or stdin. Overwrites secrets.env."
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"
src="${3:--}"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

secrets="$(secrets_path "$user" "$domain")"
tmp="${secrets}.tmp.$$"

input_cmd=(cat)
if [[ "$src" != "-" ]]; then
	[[ -f "$src" ]] || {
		echo "Error: secrets file not found: $src" >&2
		exit 1
	}
	input_cmd=(cat "$src")
fi

{
	echo "# Build-only environment (never copied to webroot)"
	echo "# Written by v-plugin-git-secrets-write"
	"${input_cmd[@]}" | while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line#"${line%%[![:space:]]*}"}"
		[[ -z "$line" || "$line" == \#* ]] && continue
		[[ "$line" == *"="* ]] || continue
		key="${line%%=*}"
		val="${line#*=}"
		[[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
		if [[ "$val" =~ ^\".*\"$ || "$val" =~ ^\'.*\'$ ]]; then
			val="${val:1:${#val}-2}"
		fi
		printf '%s=%q\n' "$key" "$val"
	done
} >"$tmp"

chmod 600 "$tmp"
mv -f "$tmp" "$secrets"
chown_site "$user" "$secrets"
echo "OK"
