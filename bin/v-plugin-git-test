#!/usr/bin/env bash
# info: test git deploy remote access
# options: USER DOMAIN
# labels: panel web
#
# example: v-plugin-git-test alice example.com
#
# Runs git ls-remote against the configured REPO_URL/BRANCH using the site
# deploy key (or HTTPS helper). Does not clone or deploy.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/deploy-engine.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-test <user> <domain>"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"
load_config "$user" "$domain"

if [[ -z "${REPO_URL:-}" ]]; then
	echo "Error: REPO_URL is empty" >&2
	exit 1
fi

branch="${BRANCH:-main}"
envp="$(git_env_prefix "$user" "$domain")"

set +e
# Combine stdout/stderr so auth errors are visible to the caller
# shellcheck disable=SC2086
out="$(run_as_user_bash "$user" "export ${envp}; git ls-remote --heads $(printf %q "$REPO_URL") $(printf %q "$branch") 2>&1")"
rc=$?
set -e

if [[ $rc -ne 0 ]]; then
	msg="$(sanitize_line "${out:-git ls-remote failed}")"
	msg="$(printf '%s\n' "$msg" | awk 'NF{line=$0} END{print line}')"
	echo "Error: cannot reach repository (${msg})" >&2
	exit 1
fi

# On success, first column of first line is the commit sha
sha="$(printf '%s\n' "$out" | awk '/^[0-9a-f]{7,}/ {print $1; exit}')"
if [[ -z "$sha" ]]; then
	echo "Error: branch '${branch}' not found on remote (or empty repo)" >&2
	exit 1
fi

short="${sha:0:7}"

echo "OK"
echo "REPO_URL: ${REPO_URL}"
echo "BRANCH:   ${branch}"
echo "COMMIT:   ${short}"
echo "REF:      refs/heads/${branch}"
