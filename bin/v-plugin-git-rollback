#!/usr/bin/env bash
# info: rollback web domain git deploy
# options: USER DOMAIN [RELEASE_ID]
# labels: panel web
#
# example: v-plugin-git-rollback alice example.com
# example: v-plugin-git-rollback alice example.com 20260922-143015-abc1234

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/deploy-engine.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-rollback <user> <domain> [release_id]"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"
release_id="${3:-}"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

export GIT_DEPLOY_VERBOSE="${GIT_DEPLOY_VERBOSE:-1}"

if run_rollback "$user" "$domain" "$release_id"; then
	echo "OK"
	echo "RELEASE: $(current_release_id "$user" "$domain")"
	exit 0
else
	exit 1
fi
