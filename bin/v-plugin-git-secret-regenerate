#!/usr/bin/env bash
# info: regenerate webhook secret for git deploy
# options: USER DOMAIN
# labels: panel web
#
# Prints the new secret once (shown-once UX).

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-secret-regenerate <user> <domain>"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

secret="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | xxd -p -c 32)"
cfg="$(config_path "$user" "$domain")"
set_config_value "$cfg" "WEBHOOK_SECRET" "$secret"
chown_site "$user" "$cfg"

echo "OK"
echo "WEBHOOK_SECRET: ${secret}"
