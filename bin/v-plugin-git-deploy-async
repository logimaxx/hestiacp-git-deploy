#!/usr/bin/env bash
# info: start git deploy in background
# options: USER DOMAIN [FORCE]
# labels: panel web
#
# example: v-plugin-git-deploy-async alice example.com
# example: v-plugin-git-deploy-async alice example.com force
#
# Returns immediately. Used by the panel UI and webhook (hestiaweb may only
# sudo /usr/local/hestia/bin/*, not systemd-run).

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/deploy-engine.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-deploy-async <user> <domain> [force]"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"
force_arg="${3:-}"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

deploy_bin="${PLUGIN_ROOT}/bin/v-plugin-git-deploy"
if [[ ! -x "$deploy_bin" ]]; then
	echo "Error: deploy binary missing: $deploy_bin" >&2
	exit 1
fi

args=("$user" "$domain")
if [[ "$force_arg" == "force" || "$force_arg" == "--force" || "$force_arg" == "1" ]]; then
	args+=("force")
fi

# Immediate UI feedback before the worker starts
started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
write_status "$user" "$domain" "running" \
	"$(read_status_field "$user" "$domain" last_status)" \
	"$(read_status_field "$user" "$domain" last_commit)" \
	"$(read_status_field "$user" "$domain" last_release)" \
	"$started" "" 0 "Deploy queued"
fix_git_deploy_perms "$user" "$domain"

logfile="$(log_path "$user" "$domain")"
mkdir -p "$(dirname "$logfile")"
touch "$logfile"
chown_site "$user" "$logfile"

# Already root when invoked via hestiaweb sudo → bin/* ; background the real deploy.
# Prefer systemd-run when available (clean cgroup); else nohup.
queued=0
if command -v systemd-run >/dev/null 2>&1; then
	if systemd-run --collect --uid=root "$deploy_bin" "${args[@]}" >/dev/null 2>&1; then
		queued=1
	fi
fi
if [[ $queued -eq 0 ]]; then
	nohup "$deploy_bin" "${args[@]}" >>"$logfile" 2>&1 </dev/null &
	disown || true
fi

echo "OK"
echo "DOMAIN: ${domain}"
echo "STATE:  running"
