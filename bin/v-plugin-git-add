#!/usr/bin/env bash
# info: add git deploy for web domain
# options: USER DOMAIN REPO_URL [BRANCH]
# labels: panel web
#
# example: v-plugin-git-add alice example.com git@github.com:org/repo.git main
#
# Initializes git-deploy structure, SSH deploy key, known_hosts, config, webhook secret.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
hestia_bootstrap

# Always surface unexpected exits (empty UI errors are hard to debug)
trap 'rc=$?; if [[ $rc -ne 0 ]]; then echo "Error: v-plugin-git-add failed (exit ${rc})" >&2; fi' EXIT

usage() {
	echo "Usage: v-plugin-git-add <user> <domain> <repo_url> [branch]"
	exit 1
}

[[ $# -ge 3 ]] || usage

user="$1"
domain="$2"
repo_url="$3"
branch="${4:-main}"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"

deploy_dir="$(git_deploy_dir "$user" "$domain")"
src_dir="$(git_src_dir "$user" "$domain")"
cfg="$(config_path "$user" "$domain")"

if [[ -f "$cfg" ]]; then
	# Idempotent: panel may re-POST enable if it couldn't read config (perms).
	# Refresh perms and print existing key so UI can continue setup.
	fix_git_deploy_perms "$user" "$domain"
	pub="$(deploy_key_pub_path "$user" "$domain")"
	echo "OK"
	echo "DOMAIN:          ${domain}"
	echo "REPO_URL:        $(grep -E '^REPO_URL=' "$cfg" | head -1 | cut -d= -f2-)"
	echo "BRANCH:          $(grep -E '^BRANCH=' "$cfg" | head -1 | cut -d= -f2-)"
	echo "DEPLOY_KEY_PUB:  ${pub}"
	echo "NOTE:            already configured"
	if [[ -f "$pub" ]]; then
		echo ""
		echo "Add the public key as a Deploy Key (read-only) in your Git host:"
		echo "-----"
		cat "$pub"
		echo "-----"
	fi
	trap - EXIT
	exit 0
fi

mkdir -p "$deploy_dir/releases" "$src_dir"
chmod 755 "$deploy_dir"
chown_site "$user" "$deploy_dir" "$src_dir"

# secrets stub
secrets="$(secrets_path "$user" "$domain")"
if [[ ! -f "$secrets" ]]; then
	cat >"$secrets" <<'EOF'
# Build-only environment (never copied to webroot)
# GIT_TOKEN=
# GIT_USERNAME=git
EOF
	chmod 600 "$secrets"
fi

generate_deploy_key "$user" "$domain"
update_known_hosts "$user" "$domain"

webhook_secret="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | xxd -p -c 32)"
key_path="$(deploy_key_path "$user" "$domain")"

# Quote values so `source config.conf` is safe
quote_cfg() {
	local v="$1"
	v="${v//\\/\\\\}"
	v="${v//\"/\\\"}"
	printf '"%s"' "$v"
}

cat >"$cfg" <<EOF
REPO_URL=$(quote_cfg "$repo_url")
BRANCH=$(quote_cfg "$branch")
AUTH_METHOD=ssh
INSTALL_CMD=
OUTPUT_DIR=dist
EXCLUDE=.git,.env,.env.*,node_modules
DEPLOY_KEY_PATH=$(quote_cfg "$key_path")
WEBHOOK_SECRET=$(quote_cfg "$webhook_secret")
AUTO_DEPLOY=yes
TIMEOUT_SECONDS=300
MAX_RELEASES=5
HEALTHCHECK_URL=
HEALTHCHECK_EXPECT=200
GIT_SUBMODULES=no
LAST_DEPLOYED_COMMIT=
SETUP_DONE=no
EOF
chmod 644 "$cfg"

write_status "$user" "$domain" "idle" "" "" "" "" "" 0 "Initialized"
: >"$(log_path "$user" "$domain")"
fix_git_deploy_perms "$user" "$domain"

pub="$(deploy_key_pub_path "$user" "$domain")"
echo "OK"
echo "DOMAIN:          ${domain}"
echo "REPO_URL:        ${repo_url}"
echo "BRANCH:          ${branch}"
echo "DEPLOY_KEY_PUB:  ${pub}"
echo "WEBHOOK_SECRET:  ${webhook_secret}"
echo ""
echo "Add the public key as a Deploy Key (read-only) in your Git host:"
echo "-----"
cat "$pub"
echo "-----"
echo ""
echo "Next: edit ${cfg} (INSTALL_CMD, OUTPUT_DIR), then run:"
echo "  v-plugin-git-deploy ${user} ${domain}"
trap - EXIT
