#!/usr/bin/env bash
# info: deploy web domain from git
# options: USER DOMAIN [FORCE]
# labels: panel web
#
# example: v-plugin-git-deploy alice example.com
# example: v-plugin-git-deploy alice example.com force
#
# Runs: lock → fetch → install → release → switch → healthcheck → status.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/main.sh"
# shellcheck source=/dev/null
source "${PLUGIN_ROOT}/func/deploy-engine.sh"
hestia_bootstrap

usage() {
	echo "Usage: v-plugin-git-deploy <user> <domain> [force]"
	exit 1
}

[[ $# -ge 2 ]] || usage

user="$1"
domain="$2"
force_arg="${3:-}"

require_root_or_owner "$user"
validate_user_domain "$user" "$domain"
require_git_deploy "$user" "$domain"

if [[ "$force_arg" == "force" || "$force_arg" == "--force" || "$force_arg" == "1" ]]; then
	export FORCE_DEPLOY=1
else
	export FORCE_DEPLOY=0
fi

export GIT_DEPLOY_VERBOSE="${GIT_DEPLOY_VERBOSE:-1}"

if run_deploy "$user" "$domain"; then
	echo "OK"
	echo "STATUS: $(read_status_field "$user" "$domain" last_status)"
	echo "COMMIT: $(read_status_field "$user" "$domain" last_commit)"
	echo "RELEASE: $(read_status_field "$user" "$domain" last_release)"
	exit 0
else
	echo "Error: deploy failed — see $(log_path "$user" "$domain")" >&2
	exit 1
fi
